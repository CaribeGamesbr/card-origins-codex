/* Gemini credentials remain in ScriptProperties, never in HTML, URLs or logs. */
function hasGeminiVisionTest_(){return PropertiesService.getScriptProperties().getProperty('GEMINI_VISION_VERIFIED')===geminiModel_()}
function requireGeminiVisionTest_(){if(!hasGeminiVisionTest_())throw Error('Antes de ativar, conclua e confira uma leitura real de print com o modelo atual. O teste de conexão sozinho não valida a leitura.');}
function geminiKey_(){var k=PropertiesService.getScriptProperties().getProperty('GEMINI_API_KEY');if(!k||k.length<20||/\s/.test(k))throw Error('A chave do Gemini ainda não foi configurada nas propriedades protegidas.');return k}
function geminiModel_(){var model=PropertiesService.getScriptProperties().getProperty('GEMINI_MODEL')||'gemini-3.5-flash';if(!/^gemini-[a-zA-Z0-9.-]+$/.test(model))throw Error('O modelo Gemini configurado é inválido.');return model}
function geminiError_(status){return new Error(status===429?'A cota do Gemini foi atingida. Não houve repetição automática nem cobrança habilitada pelo cadastro. Aguarde a renovação da cota ou confira o limite no AI Studio.':status===400||status===401||status===403?'O Gemini não autorizou esta leitura. Confira a chave, a permissão da API e a disponibilidade do modelo no AI Studio.':status===404?'O modelo configurado não está disponível nesta API. Confira GEMINI_MODEL nas propriedades.':'O Gemini não concluiu a leitura (HTTP '+status+'). Tente novamente mais tarde. Nenhuma carta foi salva.')}
function testGeminiConnection(){owner_();var model=geminiModel_(),response=UrlFetchApp.fetch('https://generativelanguage.googleapis.com/v1beta/models/'+model,{headers:{'x-goog-api-key':geminiKey_()},muteHttpExceptions:true}),status=response.getResponseCode();if(status!==200)throw geminiError_(status);var info=JSON.parse(response.getContentText());if((info.supportedGenerationMethods||[]).indexOf('generateContent')<0)throw Error('Este modelo não permite a leitura usada pelo cadastro.');return {ready:true,model:model,message:'Conexão do Gemini confirmada. Nenhuma imagem foi enviada neste teste.'}}
function listGeminiReaderModels(){owner_();var response=UrlFetchApp.fetch('https://generativelanguage.googleapis.com/v1beta/models?pageSize=1000',{headers:{'x-goog-api-key':geminiKey_()},muteHttpExceptions:true});if(response.getResponseCode()!==200)throw geminiError_(response.getResponseCode());return (JSON.parse(response.getContentText()).models||[]).filter(function(m){return /gemini-.*flash/.test(m.name)&&!/image|tts|audio|live|embedding/.test(m.name)&&(m.supportedGenerationMethods||[]).indexOf('generateContent')>=0}).map(function(m){return m.name.replace(/^models\//,'')})}
function readCardPrint(payload){owner_();geminiKey_();if(!payload||payload.mimeType!=='image/png'||typeof payload.base64!=='string'||payload.base64.length>8*1024*1024||!/^[A-Za-z0-9+/]+={0,2}$/.test(payload.base64))throw Error('Envie um print PNG válido de até 6 MB.');var bytes=Utilities.base64Decode(payload.base64);if(bytes.length<8||bytes.length>6*1024*1024||(bytes[0]+256)%256!==137||bytes[1]!==80||bytes[2]!==78||bytes[3]!==71)throw Error('O print para leitura não é um PNG válido.');
 var model=geminiModel_(),hash=Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256,bytes).map(function(b){return ('0'+((b+256)%256).toString(16)).slice(-2)}).join(''),cache=CacheService.getUserCache(),cacheKey='gemini-card-v1:'+model+':'+hash,cached=cache.get(cacheKey);if(cached){var previous=JSON.parse(cached);previous.cached=true;return previous}
 var lock=LockService.getUserLock();if(!lock.tryLock(1000))throw Error('Uma leitura ainda está em andamento. Aguarde antes de tentar outro print.');try{
 var props=PropertiesService.getScriptProperties(),day=Utilities.formatDate(new Date(),'America/Sao_Paulo','yyyy-MM-dd'),count=JSON.parse(props.getProperty('GEMINI_READ_BUDGET')||'null');if(!count||count.day!==day)count={day:day,used:0};if(count.used>=30)throw Error('O limite de proteção deste cadastro é de 30 leituras por dia. Ele será renovado amanhã.');count.used++;props.setProperty('GEMINI_READ_BUDGET',JSON.stringify(count));
 var body={systemInstruction:{parts:[{text:GeminiCardCore.prompt()}]},contents:[{role:'user',parts:[{text:'Transcreva esta carta ou suporte e traduza a habilidade para português, sem completar dados ausentes.'},{inlineData:{mimeType:'image/png',data:payload.base64}}]}],generationConfig:{responseMimeType:'application/json',responseSchema:GeminiCardCore.schema(),temperature:0,maxOutputTokens:8192}};
 var response=UrlFetchApp.fetch('https://generativelanguage.googleapis.com/v1beta/models/'+model+':generateContent',{method:'post',contentType:'application/json',headers:{'x-goog-api-key':geminiKey_()},payload:JSON.stringify(body),muteHttpExceptions:true}),status=response.getResponseCode();if(status!==200)throw geminiError_(status);
 var result=JSON.parse(response.getContentText()),candidate=(result.candidates||[])[0];if(!candidate||candidate.finishReason!=='STOP')throw Error('O Gemini não concluiu a transcrição. Envie uma imagem mais nítida ou recorte a carta; os dados anteriores foram preservados.');var text=(candidate.content.parts||[]).filter(function(p){return p.text&&!p.thought}).map(function(p){return p.text}).join(''),parsed;try{parsed=GeminiCardCore.parse(JSON.parse(text))}catch(e){throw Error('A resposta do Gemini não passou pela validação. Nenhum dado foi salvo.');}props.setProperty('GEMINI_VISION_VERIFIED',model);parsed.model=model;parsed.cached=false;parsed.usage={input:result.usageMetadata&&result.usageMetadata.promptTokenCount||0,output:result.usageMetadata&&result.usageMetadata.candidatesTokenCount||0};try{cache.put(cacheKey,JSON.stringify(parsed),1800)}catch(e){}return parsed;
 }finally{lock.releaseLock()}
}
