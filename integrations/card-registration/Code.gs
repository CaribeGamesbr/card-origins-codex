function resumeCard(requestId){owner_();token_();if(!/^[a-f0-9-]{36}$/.test(requestId))throw Error('Cadastro inválido.');var lock=LockService.getScriptLock();if(!lock.tryLock(20000))throw Error('Cadastro em andamento. Aguarde.');try{var job=job_(requestId);if(!job){var head=gh_('get','/git/ref/heads/main').object.sha,record=JSON.parse(readFile_('catalog.json',head)).find(function(c){return c.registrationId===requestId});if(!record)throw Error('Não foi encontrado um registro salvo com esse identificador. Reenvie o formulário original.');job={requestId:requestId,cardId:record.id,card:record,commit:head,docs:false}}return resumeCardUnlocked_(job)}finally{lock.releaseLock()}}
