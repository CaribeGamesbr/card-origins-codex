function image_(file,requestId){if(!file||typeof file.getBytes!=='function')return null;var bytes=file.getBytes();if(!bytes.length)return null;if(bytes.length>6*1024*1024)throw Error('O print precisa ter até 6 MB.');var a=bytes.slice(0,12).map(function(x){return (x+256)%256}),ext=a[0]===137&&a[1]===80&&a[2]===78&&a[3]===71?'png':a[0]===255&&a[1]===216&&a[2]===255?'jpg':a[0]===71&&a[1]===73&&a[2]===70?'gif':a[0]===82&&a[1]===73&&a[2]===70&&a[3]===70&&a[8]===87&&a[9]===69&&a[10]===66&&a[11]===80?'webp':null;if(!ext)throw Error('Use uma imagem PNG, JPG, GIF ou WebP válida.');return {path:'assets/cards/REGISTERED_'+requestId+'.'+ext,base64:Utilities.base64Encode(bytes),sha256:Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256,bytes).map(function(b){return ('0'+((b+256)%256).toString(16)).slice(-2)}).join('')}}
